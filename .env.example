# PostgreSQL
POSTGRES_DB=exploitation_dev
POSTGRES_USER=exploitation_dev
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=exploitation_dev
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
RABBITMQ_DEFAULT_VHOST=exploitation_dev
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Keycloak
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_PORT=8081

# S3-compatible object storage (SeaweedFS is the DEV provider)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me-object-storage
S3_SECRET_KEY=change-me-object-storage
S3_REGION=us-east-1
S3_BUCKET=exploitation-dev
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
